{
  "name": "l-system-worker",
  "version": "2.0.0",
  "private": true,
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "author": "Jan Borchers <humancatfood@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "vitest": "^1.3.1",
    "wasm-pack": "^0.12.1"
  },
  "scripts": {
    "dev": "bacon",
    "build:dev": "wasm-pack build --no-pack --out-name index --dev --out-dir dist",
    "build": "wasm-pack build --no-pack --out-name index  --out-dir dist",
    "test": "yarn test:engine && yarn test:integration",
    "test:engine": "cargo test",
    "test:integration": "wasm-pack test --node",
    "tdd:engine": "cargo watch -w src -w tests -x test",
    "tdd:integration": "cargo watch -w src -w tests -s 'yarn test:integration'",
    "postinstall": "yarn build:dev",
    "clean": "rm -rf {pkg,target,dist,node_modules}"
  }
}
