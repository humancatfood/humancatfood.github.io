{
  "name": "humancatfood.github.io",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "web-app",
    "worker"
  ],
  "scripts": {
    "dev:worker": "yarn workspace worker run dev",
    "dev:web-app": "yarn workspace web-app run dev",
    "dev": "yarn dev:worker && yarn dev:web-app",

    "build:worker": "yarn workspace worker run build",
    "build:web-app": "yarn workspace web-app run build",
    "build": "yarn build:worker && yarn build:web-app",

    "preview": "yarn workspace web-app preview",
    "test:unit": "yarn workspace web-app test:unit",
    "test:setup": "yarn workspace web-app test:setup",
    "test": "yarn workspace web-app test",
    "pretypecheck": "yarn workspace web-app pretypecheck",
    "typecheck": "yarn workspace web-app typecheck",
    "lint": "yarn workspace web-app lint",
    "clean": "yarn workspaces run clean && rm -rf {build,node_modules}",
    "install:all": "yarn install"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
