{
  "name": "humancatfood-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "yarn workspace web dev",
    "build": "yarn workspace web build",
    "preview": "yarn workspace web-app preview",
    "test:unit": "yarn workspace web-app test:unit",
    "test:setup": "yarn workspace web-app test:setup",
    "test": "yarn workspace web-app test",
    "pretypecheck": "yarn workspace web-app pretypecheck",
    "typecheck": "yarn workspace web-app typecheck",
    "lint": "yarn workspace web-app lint",
    "clean": "yarn workspaces foreach -A run clean",
    "install:all": "yarn install"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
